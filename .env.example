# Copia este archivo a .env en el servidor y rellena los valores.
# Sin comillas y sin espacios. No subas el .env al repositorio.

# Clave de API de MONEI (Ajustes → Acceso a API). Empieza en prueba y luego pasa a la real.
MONEI_API_KEY=

# Tienda creada dentro de la misma cuenta, para no mezclar estos cobros con telasaturollo.
# Panel → tiendas. Si lo dejas vacío, el cobro entra igual en la cuenta.
MONEI_STORE_ID=

# Dirección pública de esta web, sin barra final. MONEI devuelve aquí al cliente.
PUBLIC_BASE_URL=https://www.trajesromanos.com

# Usuario del listado de pedidos: weark. La contraseña es esta.
ADMIN_PASSWORD=

# 1 solo en el ordenador, para probar el carrito sin cobrar. En el servidor tiene que ser 0.
# Si hay MONEI_API_KEY, este valor se ignora.
MONEI_MOCK=0

# Correo opcional. Si lo dejas vacío, los pedidos se ven solo en /admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=weark@weark.es
SHOP_NOTIFY_EMAIL=weark@weark.es
